# Режим приложения: dev, test или prod
APP_ENV=prod

# HTTP-сервер
HTTP_ADDRESS=0.0.0.0
HTTP_PORT=8081
HTTP_READ_TIMEOUT=60s
HTTP_WRITE_TIMEOUT=60s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=artfolio
DB_PASSWORD=
DB_NAME=artfolio
DB_SSL_MODE=disable

# Goose
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./backend/migrations

# Storage
STORAGE_PATH=/var/lib/artfolio/media
STORAGE_PUBLIC_URL=/media
STORAGE_MAX_FILE_SIZE=12582912
STORAGE_MAX_PIXELS=25000000

# Kafka producer. Топик должен быть создан инфраструктурой Kafka заранее.
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=email.send
